[Unit]
Description=Mark a clean shutdown so only an unclean one forces a full root fsck and an integrity check
# 2026-11-21 (Hermes). Root has max-mount-count 1 (tune2fs -c 1). Each boot's mount makes the count 1; this
# unit resets it to 0 at a clean shutdown and leaves the clean-shutdown stamp hermes-integrity reads at boot.
# A crash or power cut skips both: the initramfs fsck (fsck.repair=yes) sees 1 >= 1 and runs a full e2fsck -y,
# and hermes-integrity checks the SD card against the SSD before headscale, docker and keepalived start.
# Revert: systemctl disable --now hermes-clean-shutdown; tune2fs -c -1 /dev/disk/by-partuuid/015164ca-02
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/sh -c 'mkdir -p /var/lib/hermes-integrity && touch /var/lib/hermes-integrity/clean-shutdown && sync'
ExecStop=/sbin/tune2fs -C 0 /dev/disk/by-partuuid/015164ca-02

[Install]
WantedBy=multi-user.target
