<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="site.fysh.bus">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

  <application android:label="YEG Bus" android:icon="@drawable/ic_launcher"
    android:theme="@style/App">
    <!-- configChanges: turning the phone sideways (wall board) keeps the page instead of reloading it. -->
    <activity android:name=".MainActivity" android:exported="true"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <receiver android:name=".BusWidget" android:exported="true" android:label="Next buses">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info"/>
    </receiver>
  </application>
</manifest>
