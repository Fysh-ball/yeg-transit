<?xml version="1.0" encoding="utf-8"?>
<!-- 30 min is Android's shortest automatic refresh; the app also refreshes it while open, and ↻ does on tap. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="250dp" android:minHeight="110dp" android:minResizeWidth="110dp" android:minResizeHeight="50dp"
  android:maxResizeWidth="600dp" android:maxResizeHeight="600dp" android:targetCellWidth="4" android:targetCellHeight="2"
  android:updatePeriodMillis="1800000" android:initialLayout="@layout/widget"
  android:resizeMode="horizontal|vertical" android:widgetCategory="home_screen"
  android:description="@string/widget_desc"/>
