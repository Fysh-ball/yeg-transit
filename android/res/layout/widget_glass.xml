<?xml version="1.0" encoding="utf-8"?>
<!-- Glass widget: the Material one (widget.xml) see-through, with shadowed white text that reads on any wallpaper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
  android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
  android:gravity="center_vertical" android:background="@drawable/widget_bg" android:padding="14dp">
  <LinearLayout android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDy="1" android:id="@+id/stop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:textSize="12sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
    <TextClock android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDy="1" android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:format12Hour="h:mm" android:format24Hour="H:mm" android:textSize="12sp" android:textStyle="bold"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical">
    <ImageView android:id="@+id/cookie" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:orientation="vertical" android:paddingStart="12dp">
      <TextView android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDy="1" android:id="@+id/big" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="30sp" android:textStyle="bold" android:singleLine="true" android:includeFontPadding="false"/>
      <TextView android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDy="1" android:id="@+id/dest" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
  </LinearLayout>
  <ImageView android:id="@+id/wave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
  <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginTop="4dp"/>
</LinearLayout>
