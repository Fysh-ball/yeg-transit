<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="6dp" android:layout_marginTop="3dp">
  <ImageView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/head" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
    android:paddingStart="8dp" android:textColor="@color/fg" android:textSize="14sp" android:singleLine="true" android:ellipsize="end"/>
  <TextView android:id="@+id/times" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:paddingStart="8dp" android:textColor="@color/fg" android:textSize="16sp" android:textStyle="bold"/>
</LinearLayout>
