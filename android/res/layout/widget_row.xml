<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
  <TextView android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDy="1" android:id="@+id/route" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp"
    android:gravity="center" android:paddingStart="5dp" android:paddingEnd="5dp" android:textColor="#FFFFFFFF"
    android:textSize="13sp" android:textStyle="bold" android:background="#FF17694A"/>
  <TextView android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDy="1" android:id="@+id/head" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
    android:paddingStart="8dp" android:textColor="@color/fg" android:textSize="15sp" android:singleLine="true" android:ellipsize="end"/>
  <TextView android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDy="1" android:id="@+id/times" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:paddingStart="8dp" android:textColor="@color/fg" android:textSize="18sp" android:textStyle="bold"/>
</LinearLayout>
